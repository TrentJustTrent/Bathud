#!/usr/bin/env bash

# Directory to scan is passed as the first argument
DIR=$1

if [ -z "$DIR" ]; then
    echo "Error: Please provide a directory path as an argument."
    exit 1
fi

echo "Searching for GIFs in: $DIR"

# Find all gif files recursively and convert them
find "$DIR" -iname "*.gif" -print0 | while IFS= read -r -d '' filename; do
    # Define the output filename with .jpeg extension
    output_filename="${filename%.*}_ff.jpg"
    
    # Use ImageMagick convert to extract the first frame ( [0] ) and save as JPEG
    # -coalesce is used to ensure proper handling of optimization in the original GIF frames
    convert "$filename" -coalesce -strip "[0]" "$output_filename"
    echo "Generated preview: $output_filename"
done

echo "Preview generation complete."